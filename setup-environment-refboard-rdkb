# Save _TOPDIR
_TOPDIR=`pwd`

export RDK_BSP_LAYER=none

if [ "X$MP_version" == "X4.3" ] && [ ! -e ${_TOPDIR}/meta-cmf-filogic/MP4_3_applied ] && [ ! -e ${_TOPDIR}/meta-filogic/MP4_3_applied ];
then
    cd ${_TOPDIR}/meta-filogic
    git checkout 01f7d0b641fdf230fe1120870afe419ef4a9257b
    cd -
    cd ${_TOPDIR}/meta-cmf-filogic
    git checkout 07212d3b7521be5555f5c8f273bbaa4c52a1a5d5
    cd -
    sed -i '/^#*DISTRO_FEATURES:append = " kernel6-12"$/s/^#//' \
    ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/{rdk-bpi.inc,rdk-bpi-ap-extender.inc}
    sed -i '/^DISTRO_FEATURES:append = " kernel6-6"$/s/^/#/' \
    ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/{rdk-bpi.inc,rdk-bpi-ap-extender.inc}
    echo 'RDEPENDS:${PN}-dev = ""' >> ${_TOPDIR}/meta-filogic/recipes-kernel/linux6-12-libc-headers/linux-libc-headers.inc
    touch ${_TOPDIR}/meta-cmf-filogic/MP4_3_applied
    touch ${_TOPDIR}/meta-filogic/MP4_3_applied
fi

if [ "X$MP_version" == "X4.3" ] ;then
   if [ -e "${_TOPDIR}/meta-cmf-filogic/setup-environment" ]; then
       source meta-cmf-filogic/setup-environment
   fi
else
   if [ -e "${_TOPDIR}/meta-cmf-filogic/setup-environment-release" ]; then
        source meta-cmf-filogic/setup-environment-release
   fi
   sed -i 's|SYSTEMD_SERVICE:${PN}:remove_broadband = "dropbear.service"|SYSTEMD_SERVICE:${PN}:remove_broadband = "${@bb.utils.contains('\''DISTRO_FEATURES'\'', '\''em_extender'\'', '\'' '\'','\''dropbear.service'\'', d)}"|' \
${_TOPDIR}/meta-cmf-filogic/recipes-rdkb/sysint-broadband/sysint-broadband.bbappend
fi

if [[ -z $(grep 'meta-rdk-broadband-apps' conf/bblayers.conf) ]] && [[ -d  ../meta-rdk-broadband-apps ]]
then
    cat >> conf/bblayers.conf <<EOF
BBLAYERS =+ "\${RDKROOT}/meta-rdk-broadband-apps"
EOF
fi

if [[ -z $(grep 'meta-cmf-bananapi' conf/bblayers.conf) ]] && [[ -d  ../meta-cmf-bananapi ]]
then
    cat >> conf/bblayers.conf <<EOF
BBLAYERS =+ "\${RDKROOT}/meta-cmf-bananapi"
EOF
fi

# default BSP layer is meta-cmf-bananapi for B-PI builds
export RDK_BSP_LAYER=meta-cmf-bananapi

if [ ! -e ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia_changes_applied ]; then
sed -i '/^EXTRA_OECONF:remove.*bcm/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/posix-gwprovapp\.patch/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/0002-fix-swctl-missing-api\.patch/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/bbnote.*posix-gwprovapp/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/patch.*posix-gwprovapp/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/bbnote.*0002-fix-swctl/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/patch.*0002-fix-swctl/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/sysevent set lan-start 0/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/sysevent set bridge-stop 0/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/sysevent set bridge_mode */s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/echo.*sysevent set lan-status started/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/echo.*firewall/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/execute_dir \/etc\/utopia\/post\.d/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/touch \/tmp\/\.postd_started/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/lan-status started*/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
sed -i '/sysevent set wan-status started*/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia.bbappend
touch ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia_changes_applied
fi

# commenting removing dbus.service from meta-cmf-filogic
if [ ! -e ${_TOPDIR}/meta-cmf-filogic/recipes-core/dbus/dbus_change ]; then
sed -i '/rm.*dbus\.service/s/^/#/' ${_TOPDIR}/meta-cmf-filogic/recipes-core/dbus/dbus_%.bbappend
touch ${_TOPDIR}/meta-cmf-filogic/recipes-core/dbus/dbus_change
fi

if [ ! -e ${_TOPDIR}/meta-cmf-filogic/recipes-core/images/python_binary_removed ];then
sed -i '/python/d' ${_TOPDIR}/meta-cmf-filogic/recipes-core/images/image-exclude-files.inc
touch ${_TOPDIR}/meta-cmf-filogic/recipes-core/images/python_binary_removed
fi

if [ ! -e ${_TOPDIR}/meta-filogic/recipes-wifi/hal/mt76_hal_change ];then
echo "DEPENDS += \"rdk-wifi-halif\"" >> ${_TOPDIR}/meta-filogic/recipes-wifi/hal/hal-wifi-mt76.bb
echo "DEPENDS += \"rdk-wifi-halif\"" >> ${_TOPDIR}/meta-cmf-broadband/recipes-ccsp/hal/hal-wifi-cfg80211_git.bb
touch ${_TOPDIR}/meta-filogic/recipes-wifi/hal/mt76_hal_change
fi

if grep -q 'librdmopenssl' ${_TOPDIR}/meta-rdk/recipes-common/rdm-agent/rdm-agent.bb; then
    sed -i \
        -e '/librdmopenssl/d' \
        -e '/rdm_rsa_signature_verify/d' \
        -e '/install -d.*\${D}\${includedir}\/rdm$/d' \
        -e '/install -d.*\${D}\${libdir}$/d' \
        ${_TOPDIR}/meta-rdk/recipes-common/rdm-agent/rdm-agent.bb
    touch ${_TOPDIR}/meta-rdk/recipes-common/rdm-agent/rdm_hal_change
fi

if [ "X$FEATURE_TYPE" == "XEasyMesh" ]; then
    sed -i '/EasyMesh/s/^#//' ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/rdk-bpi.inc
    sed -i '/with_alsap/s/^#//' ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/rdk-bpi.inc
    sed -i '/generic_mlo/s/^#//' ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/rdk-bpi.inc
    if [ "X$EM_UNITTEST" == "Xyes" ]; then
    	sed -i '/Em_Unittest/s/^#//' ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/rdk-bpi.inc
    fi	
fi

if [ "X$ci_Staged_AUTOREV_Validation_Enabled" == "Xyes" ]; then
    sed -i '/BuildFromTip/s/^#//' ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/rdk-bpi.inc
    sed -i '/BuildFromTip/s/^#//' ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/rdk-bpi-ap-extender.inc
fi

if [ "X$FEATURE_TYPE" == "XEasyMesh" ] && [ "X$WITHOUT_ALSAP" == "Xyes" ]; then
    sed -i '/with_alsap/s/^/#/' ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/rdk-bpi.inc
    sed -i '/with_alsap/s/^/#/' ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/rdk-bpi-ap-extender.inc
    sed -i 's/$al_mac/$br_mac/g' ${_TOPDIR}/meta-cmf-broadband/recipes-ccsp/unified-wifi-mesh/files/setup_mysql_db_post.sh
    if [ "X$EM_UNITTEST" == "Xyes" ]; then
    	sed -i '/Em_Unittest/s/^#//' ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/rdk-bpi.inc
    fi	
fi


echo 'RDEPENDS:${PN}-dev = ""' >> ${_TOPDIR}/meta-filogic/recipes-kernel/linux6-6-libc-headers/linux-libc-headers.inc

if [ "X$BPI_IMG_TYPE" == "Xnand" ]; then
    sed -i '/sdmmc/s/^/#/' ${_TOPDIR}/meta-cmf-bananapi/conf/distro/include/rdk-bpi.inc
else # SD card image is default
    mkdir -p ${_TOPDIR}/downloads
    if [ -f ${_TOPDIR}/downloads/bpi-r4_sdmmc_bl2_6-6.img ] && [ -f ${_TOPDIR}/downloads/bpi-r4_sdmmc_fip_6-6.bin ] && [ -f ${_TOPDIR}/downloads/bpi-r4_sdmmc_bl2_B_6-6.img ] && [ -f ${_TOPDIR}/downloads/bpi-r4_sdmmc_fip_B_6-6.bin ]; then
	    echo "Both bl2 and fip binaries are present in local workspace for 6.x kernel."
    else
	    echo "**********************************************************************"
	    echo "> Missing files are preventing the build from starting:"
	    echo "> The BL2 and FIP binaries for kernel-6.x aren't in the downloads directory. Copy these binaries into the directory and then restart the build. You can find instructions for creating the necessary binaries on the RDK-B Code Releases page: (https://wiki.rdkcentral.com/display/CMF/RDK-B+Code+Releases)"
	    echo "**********************************************************************"
	    return 1
     fi
fi
