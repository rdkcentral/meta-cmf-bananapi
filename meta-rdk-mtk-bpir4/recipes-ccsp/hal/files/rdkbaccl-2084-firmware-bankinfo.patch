+static INT rdkb_get_partition_by_partlabel(const char *partLabel, CHAR *devicePath, size_t devicePathSize)
+{
+FILE *fp = NULL;
+char command[256] = {0};
+char output[256] = {0};
+char *newline = NULL;
+int status;
+ 
+if ((partLabel == NULL) || (partLabel[0] == '\0') || (devicePath == NULL) || (devicePathSize == 0))
+return RETURN_ERR;
+ 
+devicePath[0] = '\0';
+ 
+if (snprintf(command, sizeof(command), "%s -t PARTLABEL=\"%s\" -o device", RDKB_BLKID_COMMAND, partLabel) >= (int)sizeof(command))
+return RETURN_ERR;
+ 
+fp = popen(command, "r");
+if (fp == NULL)
+{
+printf("RDKB: failed to execute %s errno=%d\n", command, errno);
+return RETURN_ERR;
+}
+ 
+if (fgets(output, sizeof(output), fp) == NULL)
+{
+status = pclose(fp);
+printf("RDKB: PARTLABEL=%s not found status=%d\n", partLabel, status);
+return RETURN_ERR;
+}
+ 
+status = pclose(fp);
+if (status != 0)
+{
+printf("RDKB: blkid failed for PARTLABEL=%s status=%d\n", partLabel, status);
+return RETURN_ERR;
+}
+ 
+newline = strpbrk(output, "\r\n");
+if (newline != NULL)
+*newline = '\0';
+ 
+if ((output[0] == '\0') || (strncmp(output, "/dev/", 5) != 0))
+{
+printf("RDKB: invalid device for PARTLABEL=%s: %s\n", partLabel, output);
+return RETURN_ERR;
+}
+ 
+if (snprintf(devicePath, devicePathSize, "%s", output) >= (int)devicePathSize)
+{
+devicePath[0] = '\0';
+return RETURN_ERR;
+}
+ 
+printf("RDKB: discovered PARTLABEL=%s device=%s\n", partLabel, devicePath);
+return RETURN_OK;
+}
+ 
+static INT rdkb_get_active_rootfs(CHAR *rootfs, size_t rootfsSize)
+{
+FILE *fp = NULL;
+char cmdline[1024] = {0};
+char *root = NULL;
+char *end = NULL;
+ 
+if ((rootfs == NULL) || (rootfsSize == 0))
+return RETURN_ERR;
+ 
+rootfs[0] = '\0';
+ 
+fp = fopen("/proc/cmdline", "r");
+if (fp == NULL)
+return RETURN_ERR;
+ 
+if (fgets(cmdline, sizeof(cmdline), fp) == NULL)
+{
+fclose(fp);
+return RETURN_ERR;
+}
+fclose(fp);
+ 
+root = strstr(cmdline, "root=");
+if (root == NULL)
+return RETURN_ERR;
+ 
+root += strlen("root=");
+end = strpbrk(root, " \t\r\n");
+if (end != NULL)
+*end = '\0';
+ 
+if (snprintf(rootfs, rootfsSize, "%s", root) >= (int)rootfsSize)
+{
+rootfs[0] = '\0';
+return RETURN_ERR;
+}
+ 
+return RETURN_OK;
+}
+ 
+static INT rdkb_read_inactive_imagename(const char *inactiveRootfs, CHAR *fwName, size_t fwNameSize)
+{
+char versionFile[256] = {0};
+INT ret = RETURN_ERR;
+ 
+if ((inactiveRootfs == NULL) || (inactiveRootfs[0] == '\0') || (fwName == NULL) || (fwNameSize == 0))
+return RETURN_ERR;
+ 
+fwName[0] = '\0';
+ 
+if ((mkdir(RDKB_INACTIVE_MOUNT_POINT, 0755) != 0) && (errno != EEXIST))
+{
+printf("RDKB: mkdir failed errno=%d\n", errno);
+return RETURN_ERR;
+}
+ 
+umount(RDKB_INACTIVE_MOUNT_POINT);
+if (mount(inactiveRootfs, RDKB_INACTIVE_MOUNT_POINT, "ext4", MS_RDONLY, NULL) != 0)
+{
+printf("RDKB: mount %s failed errno=%d\n", inactiveRootfs, errno);
+return RETURN_ERR;
+}
+ 
+snprintf(versionFile, sizeof(versionFile), "%s/version.txt", RDKB_INACTIVE_MOUNT_POINT);
+ret = rdkb_read_imagename(versionFile, fwName, fwNameSize);
+umount(RDKB_INACTIVE_MOUNT_POINT);
+return ret;
+}
