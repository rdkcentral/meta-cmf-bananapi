+static INT rdkb_read_imagename(const char *versionFile,
+CHAR *fwName,
+size_t fwNameSize)
+{
+FILE *fp = NULL;
+char line[256] = {0};
+const char *prefix = "imagename:";
+size_t prefixLen = strlen(prefix);
+ 
+if ((versionFile == NULL) ||
+(fwName == NULL) ||
+(fwNameSize == 0))
+{
+return RETURN_ERR;
+}
+ 
+fwName[0] = '\0';
+ 
+fp = fopen(versionFile, "r");
+if (fp == NULL)
+{
+printf("RDKB: cannot open %s errno=%d\n",
+versionFile,
+errno);
+return RETURN_ERR;
+}
+ 
+while (fgets(line, sizeof(line), fp) != NULL)
