From: Somanath Bulusu <bsomanath@plume.com>
Subject: [PATCH] encode/decode WPS methods for onboarding VAPs

--- a/source/webconfig/wifi_encoder.c	2026-10-29 14:22:58.278810650 +0000
+++ b/source/webconfig/wifi_encoder.c	2026-10-29 14:22:58.305810102 +0000
@@ -510,7 +510,14 @@
     cJSON_AddBoolToObject(vap_object, "WpsEnable", vap_info->u.bss_info.wps.enable);
 
     //wpsConfigMethodsEnabled
-    if(strstr(vap_info->vap_name, "private") != NULL) {
+    /*
+     * Private and dedicated onboarding VAPs both carry WPS registrar
+     * config. Restricting encode to "*private*" left onboarding methods at
+     * 0 after decode, so hostapd never set wps_state and PBC failed with
+     * "WPS is not enabled".
+     */
+    if (strstr(vap_info->vap_name, "private") != NULL ||
+        strstr(vap_info->vap_name, "onboarding") != NULL) {
         cJSON_AddNumberToObject(vap_object, "WpsConfigMethodsEnabled", vap_info->u.bss_info.wps.methods);
         //WpsConfigPin
         cJSON_AddStringToObject(vap_object, "WpsConfigPin", vap_info->u.bss_info.wps.pin);
--- a/source/webconfig/wifi_decoder.c	2026-10-29 14:22:58.281810589 +0000
+++ b/source/webconfig/wifi_decoder.c	2026-10-29 14:22:58.306810082 +0000
@@ -1885,13 +1885,26 @@
     vap_info->u.bss_info.wps.enable = (param->type & cJSON_True) ? true : false;
 
     // wpsConfigMethodsEnabled
-    if (strstr(vap_info->vap_name, "private") != NULL) {
+    if (strstr(vap_info->vap_name, "private") != NULL ||
+        strstr(vap_info->vap_name, "onboarding") != NULL) {
         decode_param_integer(vap, "WpsConfigMethodsEnabled", param);
         vap_info->u.bss_info.wps.methods = param->valuedouble;
         // WpsConfigPin
         decode_param_allow_empty_string(vap, "WpsConfigPin", param);
         strcpy(vap_info->u.bss_info.wps.pin, param->valuestring);
     }
+#ifdef UWM_CTRL_WPS_SUPPORT
+    /*
+     * Older encodes omitted WpsConfigMethodsEnabled for onboarding VAPs, so
+     * methods landed as 0 and hostapd left wps_state disabled. Pin push-button
+     * when enabling onboarding WPS so deferred PBC can arm the registrar.
+     */
+    if (strstr(vap_info->vap_name, "onboarding") != NULL &&
+        vap_info->u.bss_info.wps.enable &&
+        vap_info->u.bss_info.wps.methods == 0) {
+        vap_info->u.bss_info.wps.methods = WIFI_ONBOARDINGMETHODS_PUSHBUTTON;
+    }
+#endif /* UWM_CTRL_WPS_SUPPORT */
     // BeaconRateCtl
     decode_param_string(vap, "BeaconRateCtl", param);
     strcpy(vap_info->u.bss_info.beaconRateCtl, param->valuestring);
