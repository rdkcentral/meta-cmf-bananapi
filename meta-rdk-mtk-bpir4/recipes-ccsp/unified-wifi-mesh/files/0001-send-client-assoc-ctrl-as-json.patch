From: Somanath Bulusu <bsomanath@plume.com>
Subject: [PATCH] Send client association control to OneWifi as JSON

client_assoc_ctrl_req_t is not a type in this tree. OneWifi consumes
WIFI_EM_CLIENT_ASSOC_CTRL_REQ only as a JSON string.

---
 src/agent/em_agent.cpp | 54 ++++++++++++++++++++++++++++++++++----------------
 1 file changed, 37 insertions(+), 17 deletions(-)

diff --git a/src/agent/em_agent.cpp b/src/agent/em_agent.cpp
index 53593a2e..fbe6fa53 100644
--- a/src/agent/em_agent.cpp
+++ b/src/agent/em_agent.cpp
@@ -787,9 +787,16 @@ void em_agent_t::handle_client_assoc_ctrl_req(em_bus_event_t *evt)
 {
     wifi_bus_desc_t *desc;
     raw_data_t raw;
-    client_assoc_ctrl_req_t req_data;
+    char bssid_str[18];
+    char sta_str[18];
+    char *json_str;
+    cJSON *root;
+    cJSON *req;
+    cJSON *sta_list;
+    const unsigned char *bssid;
+    const unsigned char *sta_mac;
 
-    em_client_assoc_ctrl_req_t *steer_req = reinterpret_cast<em_client_assoc_ctrl_req_t*> (&evt->u.raw_buff);
+    em_client_assoc_ctrl_req_t *steer_req = reinterpret_cast<em_client_assoc_ctrl_req_t *>(&evt->u.raw_buff);
 
     if ((desc = get_bus_descriptor()) == NULL) {
         em_printfout("bus descriptor is null");
@@ -800,23 +807,45 @@ void em_agent_t::handle_client_assoc_ctrl_req(em_bus_event_t *evt)
         em_printfout("station count:%d is more than one", steer_req->count);
         return;
     }
-    memset(&req_data, 0, sizeof(client_assoc_ctrl_req_t));
 
-    memcpy(req_data.bssid, steer_req->bssid, sizeof(bssid_t));
-    req_data.assoc_control = steer_req->assoc_control;
-    req_data.validity_period = ntohs(steer_req->validity_period);
-    req_data.count = steer_req->count;
-    memcpy(req_data.sta_mac, steer_req->sta_mac, sizeof(mac_address_t));
+    bssid = reinterpret_cast<const unsigned char *>(steer_req->bssid);
+    sta_mac = reinterpret_cast<const unsigned char *>(steer_req->sta_mac);
+    snprintf(bssid_str, sizeof(bssid_str), "%02x:%02x:%02x:%02x:%02x:%02x",
+        bssid[0], bssid[1], bssid[2], bssid[3], bssid[4], bssid[5]);
+    snprintf(sta_str, sizeof(sta_str), "%02x:%02x:%02x:%02x:%02x:%02x",
+        sta_mac[0], sta_mac[1], sta_mac[2], sta_mac[3], sta_mac[4], sta_mac[5]);
 
-    memset(&raw, 0, sizeof(raw_data_t));
-    raw.data_type = bus_data_type_bytes;
-    raw.raw_data.bytes = static_cast<void *>(&req_data);
-    raw.raw_data_len = sizeof(client_assoc_ctrl_req_t);
+    root = cJSON_CreateObject();
+    req = (root == NULL) ? NULL : cJSON_AddObjectToObject(root, "ClientAssocCtrlRequest");
+    sta_list = (req == NULL) ? NULL : cJSON_AddArrayToObject(req, "StaMacList");
+    if (sta_list == NULL) {
+        cJSON_Delete(root);
+        em_printfout("failed to create client assoc ctrl JSON");
+        return;
+    }
+    cJSON_AddStringToObject(req, "Bssid", bssid_str);
+    cJSON_AddNumberToObject(req, "AssocControl", steer_req->assoc_control);
+    cJSON_AddNumberToObject(req, "ValidityPeriod", ntohs(steer_req->validity_period));
+    cJSON_AddItemToArray(sta_list, cJSON_CreateString(sta_str));
 
-    if (desc->bus_set_fn(&m_bus_hdl,WIFI_EM_CLIENT_ASSOC_CTRL_REQ, &raw) != 0) {
-        em_printfout("%s:%d Failed to send client assoc ctrl request to bus",__func__, __LINE__);
+    json_str = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (json_str == NULL) {
+        em_printfout("failed to serialize client assoc ctrl JSON");
+        return;
     }
-    em_printfout("%s:%d Sent client assoc ctrl request to bus, OneWifi will process the bus event",__func__, __LINE__);
+
+    memset(&raw, 0, sizeof(raw));
+    raw.data_type = bus_data_type_string;
+    raw.raw_data.bytes = json_str;
+    raw.raw_data_len = strlen(json_str);
+
+    if (desc->bus_set_fn(&m_bus_hdl, WIFI_EM_CLIENT_ASSOC_CTRL_REQ, &raw) != 0) {
+        em_printfout("Failed to send client assoc ctrl request to bus");
+    } else {
+        em_printfout("Sent client assoc ctrl request to bus, OneWifi will process the bus event");
+    }
+    free(json_str);
 }
 
 void em_agent_t::handle_channel_scan_result(em_bus_event_t *evt)
