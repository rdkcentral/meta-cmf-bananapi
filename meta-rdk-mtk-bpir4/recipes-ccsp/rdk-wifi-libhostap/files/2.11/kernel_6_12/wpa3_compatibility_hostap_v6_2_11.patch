+        ie = hostapd_vendor_wpa_ie(hapd, WPA_RSNO_OUI_TYPE);
+       if (!ie || 2U + ie[1] > len)
+        {
+                wpa_printf(MSG_ERROR, "%s IE not found in hostapd_vendor_wpa_ie \n", __func__);
+                return pos;
