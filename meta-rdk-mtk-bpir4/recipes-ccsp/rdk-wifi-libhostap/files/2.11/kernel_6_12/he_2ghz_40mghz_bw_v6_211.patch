diff -Naur git.orig/source/hostap-2.11/src/ap/ap_config.c git/source/hostap-2.11/src/ap/ap_config.c
--- git.orig/source/hostap-2.11/src/ap/ap_config.c	2026-04-27 06:31:00.335747892 +0100
+++ git/source/hostap-2.11/src/ap/ap_config.c	2026-04-27 06:31:34.927669608 +0100
@@ -308,6 +308,7 @@
