+ 
 	bool require_he;
 	u8 mu_onoff;
 #endif /* CONFIG_IEEE80211AX */
diff -Naur git.orig/source/hostap-2.11/src/ap/ieee802_11_he.c git/source/hostap-2.11/src/ap/ieee802_11_he.c
