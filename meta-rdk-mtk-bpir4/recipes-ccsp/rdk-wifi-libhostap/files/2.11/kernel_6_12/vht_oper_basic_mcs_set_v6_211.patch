diff -Naur git.orig/source/hostap-2.11/src/ap/ap_config.h git/source/hostap-2.11/src/ap/ap_config.h
--- git.orig/source/hostap-2.11/src/ap/ap_config.h	2026-04-27 06:03:02.551523079 +0100
+++ git/source/hostap-2.11/src/ap/ap_config.h	2026-04-27 06:05:45.787135453 +0100
