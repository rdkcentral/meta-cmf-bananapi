 #!/bin/bash
+# Supports:
+#   1) Legacy:  pppoe_config.sh <start|stop> [user] [password]
+#   2) PPPMgr:  pppoe_config.sh <user> <pass> <eth_if> <ppp_if> PPPoE|PPPoA <lcp> <lcp_retry> [mru]
 source /etc/utopia/service.d/service_wan/ppp_helpers.sh
 
 PPP_CONFIG_FILE=/etc/ppp/pppoe.conf
 
-init_pppoe (){
+write_pppoe_conf () {
+    local eth_if="$1"
+    local ppp_if="$2"
+    local user="$3"
+    local lcp_interval="$4"
+    local lcp_failure="$5"
+    local mru="$6"
+    local default_route="yes"
+
+    if [ -z "$eth_if" ] || [ -z "$ppp_if" ] || [ -z "$user" ]; then
+        echo "$0: missing eth_if/ppp_if/user" >&2
+        return 1
+    fi
+
+    [ -z "$lcp_interval" ] && lcp_interval=$(syscfg get lcp_interval)
+    [ -z "$lcp_interval" ] && lcp_interval=30
+    [ -z "$lcp_failure" ] && lcp_failure=3
+    [ -z "$mru" ] && mru=$(syscfg get MaxMRUSize)
+    [ -z "$mru" ] && mru=1492
+
+    # MultiWAN: per-interface conf so parallel sessions do not share pppoe.conf/PIDFILE
+    if [ "${RDKB_MULTIWAN}" = "1" ]; then
+        PPP_CONFIG_FILE="/etc/ppp/${ppp_if}.conf"
+        # WanManager owns default-route policy across multiple WANs
+        default_route="no"
+    else
+        PPP_CONFIG_FILE=/etc/ppp/pppoe.conf
+    fi
+
     prepare_pppd_ip_pre_up_script
     prepare_pppd_ip_up_script
     prepare_pppd_ipv6_up_script
