+#ifdef __MAPE_NAT_PORTS__
+	/*
+	 * MAPE port selection path.
+	 *
+	 * Placed after the unconditional "goto another_round" above so the
+	 * compiler does not see unreachable code between labels.
+	 *
+	 * Key 6.6 differences from the original 5.15 patch:
+	 *   - off is u16 (was u32); use get_random_u16() not prandom_u32()
+	 *   - nf_nat_used_tuple_harder() used (supports TCP timewait eviction)
+	 *   - NF_NAT_MAX_ATTEMPTS replaces the removed max_attempts local var
+	 */
+find_free_id_mape:
+	off = get_random_u16();
+	attempts = range_size;
+	if (attempts > NF_NAT_MAX_ATTEMPTS)
+		attempts = NF_NAT_MAX_ATTEMPTS;
+
+another_round_mape:
+	for (i = 0; i < attempts; i++, off++) {
+		u16 index = off % range_size;
+
+		*keyptr = htons(mape_port_range[index]);
+		if (!nf_nat_used_tuple_harder(tuple, ct, attempts - i))
+			return;
+	}
+	if (attempts >= range_size || attempts < 16)
+		return;
+	attempts /= 2;
+	off = get_random_u16();
+	goto another_round_mape;
