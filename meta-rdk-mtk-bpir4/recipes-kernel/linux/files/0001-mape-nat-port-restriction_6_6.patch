+static unsigned short mape_port_range[65535] = {0};
+static int port_num = 0;
+static int psid_offset = 0, psid_len = 0, psid_val = 0;
+
+void create_port_range_by_psid(int offset, int psid_len, unsigned short psid)
+{
+	unsigned m_len = 0, i = 0;
+	int j = 0;
+	unsigned short port = 0, m_val = 0, m_offset = 0;
+
+	memset(mape_port_range, 0, sizeof(mape_port_range));
+	port_num = 0;
+	m_len = 16 - offset - psid_len;
+	for (i = 0; i < m_len; i++)
+		m_val |= 1 << i;
+	for (i = 0; i < offset; i++)
+		m_offset |= 1 << i;
+	if (m_offset) {
+		for (i = 1; i <= m_offset; i++) {
+			port = 0;
+			port |= i << (16 - offset);
+			port |= psid << m_len;
+			for (j = 0; j <= m_val; j++)
+				mape_port_range[port_num++] = port | j;
+		}
+	} else {
+		port = 0;
+		port |= psid << m_len;
+		for (j = 0; j <= m_val; j++)
+			mape_port_range[port_num++] = port | j;
+	}
+}
+
+int search_value(unsigned short int key, int low, int high)
+{
+	int mid;
+
+	if (low > high)
+		return -1;
+	mid = (low + high) / 2;
+	if (mape_port_range[mid] == key)
+		return mid;
+	else if (mape_port_range[mid] > key)
+		return search_value(key, low, mid - 1);
+	else
+		return search_value(key, mid + 1, high);
+}
+
+static void print_port_range_by_psid(int offset, int psid_len, unsigned short psid)
+{
+	unsigned m_len = 0, i = 0;
+	int j = 0;
+	short port = 0, m_val = 0, m_offset = 0;
+
+	memset(mape_port_range, 0, sizeof(mape_port_range));
+	port_num = 0;
+	m_len = 16 - offset - psid_len;
+	for (i = 0; i < m_len; i++)
+		m_val |= 1 << i;
+	for (i = 0; i < offset; i++)
+		m_offset |= 1 << i;
+	if (m_offset) {
+		for (i = 1; i <= m_offset; i++) {
+			port = 0;
+			port |= i << (16 - offset);
+			port |= psid << m_len;
+			for (j = 0; j <= m_val; j++) {
+				printk(" %hu", port | j);
+				mape_port_range[port_num++] = port | j;
+			}
+			printk("\n");
+		}
+	} else {
+		port = 0;
+		port |= psid << m_len;
+		for (j = 0; j <= m_val; j++) {
+			printk(" %hu", port | j);
+			mape_port_range[port_num++] = port | j;
+		}
+		printk("\n");
+	}
+}
+
+static ssize_t nat_port_read_proc(struct file *file, char __user *buffer,
+				  size_t count, loff_t *data)
+{
+	if (psid_val) {
+		printk("Port Ranges:\n");
+		print_port_range_by_psid(psid_offset, psid_len, psid_val);
+	}
+	printk("PSID Offset: %d\nPSID Length: %d\nPSID Value: 0x%x\n",
+	       psid_offset, psid_len, psid_val);
+	return 0;
+}
+
+static ssize_t nat_port_write_proc(struct file *file,
+				   const char __user *buffer,
+				   size_t count, loff_t *data)
+{
+	char *p0 = NULL, *p1 = NULL;
+	char psid_buf[64] = {0};
+
+	if (count >= sizeof(psid_buf))
+		return count;
+
+	if (copy_from_user(psid_buf, buffer, count))
+		return count;
+
+	p0 = strchr(psid_buf, '\n');
+	if (p0)
+		*p0 = 0;
+	p0 = psid_buf;
+	p1 = strchr(p0, ',');
+	if (!p1)
+		return count;
+	*p1++ = 0;
+	psid_offset = simple_strtoul(p0, NULL, 10);
+
+	p0 = p1;
+	p1 = strchr(p0, ',');
+	if (!p1)
+		return count;
+	*p1++ = 0;
+	psid_len = simple_strtoul(p0, NULL, 10);
+	psid_val = simple_strtoul(p1, NULL, 10);
+	printk("%d,%d,%x\n", psid_offset, psid_len, psid_val);
+	create_port_range_by_psid(psid_offset, psid_len, (unsigned short)psid_val);
+	return count;
+}
+
+static const struct proc_ops nat_port_file_fops = {
+	.proc_read  = nat_port_read_proc,
+	.proc_write = nat_port_write_proc,
+};
+#endif /* __MAPE_NAT_PORTS__ */
