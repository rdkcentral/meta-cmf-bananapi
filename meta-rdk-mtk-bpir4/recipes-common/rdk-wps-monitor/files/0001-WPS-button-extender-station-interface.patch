--- a/rdk-wps-monitor/include/button_callback.h	2026-10-29 12:16:27.229142390 +0000
+++ b/rdk-wps-monitor/include/button_callback.h	2026-10-29 12:16:47.831645947 +0000
@@ -62,4 +62,18 @@
  */
 button_callback get_button_callback(void);
 
+/**
+ * @brief Start fail-closed cleanup without delaying event monitoring.
+ *
+ * This is a no-op on extender builds.
+ */
+void start_onboarding_cleanup(void);
+
+/**
+ * @brief Force dedicated gateway onboarding VAPs into their disabled state.
+ *
+ * This is a no-op on extender builds.
+ */
+void cleanup_onboarding_vaps(void);
+
 #endif /* BUTTON_CALLBACK_H */
diff --git a/rdk-wps-monitor/source/button_callback.c b/rdk-wps-monitor/source/button_callback.c
--- a/rdk-wps-monitor/source/button_callback.c	2026-10-29 12:16:27.230142366 +0000
+++ b/rdk-wps-monitor/source/button_callback.c	2026-10-29 13:15:19.383562692 +0000
@@ -24,6 +24,9 @@
 
 #include <stdio.h>
 #include <stdlib.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <time.h>
 #include <syslog.h>
 #include "../include/button_callback.h"
 #include "../include/utils.h"
@@ -34,22 +37,255 @@
 
 pthread_mutex_t wps_mutex = PTHREAD_MUTEX_INITIALIZER;
 
-#define WPS_DELAY 60 // 60 seconds delay between presses
+static bool set_bool(rbusHandle_t handle, const char *param, bool value)
+{
+    rbusError_t err;
 
-void set_wps_push_button(rbusHandle_t handle, const char* param) {
     pthread_mutex_lock(&wps_mutex);
-
-    rbusError_t err = rbus_setBoolean(handle, param, true);
+    err = rbus_setBoolean(handle, param, value);
+    pthread_mutex_unlock(&wps_mutex);
     if (err != RBUS_ERROR_SUCCESS) {
-        printf("Failed to set %s: %d\n", param, err);
+        log_message(LOG_ERR, "Failed to set %s=%s: %d", param,
+            value ? "true" : "false", err);
+        return false;
+    }
+
+    return true;
+}
+
+void set_wps_push_button(rbusHandle_t handle, const char* param)
+{
+    (void)set_bool(handle, param, true);
+}
+
+#ifndef CONFIG_EXTENDER
+#define ONBOARDING_WINDOW_SECONDS 120
+
+static pthread_mutex_t onboarding_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t onboarding_cond;
+static pthread_once_t onboarding_once = PTHREAD_ONCE_INIT;
+static bool onboarding_armed;
+static bool onboarding_timer_ready;
+static bool startup_cleanup_done;
+static struct timespec onboarding_deadline;
+
+static bool close_onboarding_vaps(rbusHandle_t handle)
+{
+    bool ok = true;
+
+    /* Cancel is best-effort: HAL rejects it when no PBC session is active. */
+    (void)set_bool(handle,
+        "Device.WiFi.AccessPoint.5.WPS.X_CISCO_COM_CancelSession", true);
+    (void)set_bool(handle,
+        "Device.WiFi.AccessPoint.6.WPS.X_CISCO_COM_CancelSession", true);
+    ok &= set_bool(handle, "Device.WiFi.AccessPoint.5.WPS.Enable", false);
+    ok &= set_bool(handle, "Device.WiFi.AccessPoint.6.WPS.Enable", false);
+    ok &= set_bool(handle, "Device.WiFi.AccessPoint.5.Enable", false);
+    ok &= set_bool(handle, "Device.WiFi.AccessPoint.6.Enable", false);
+    ok &= set_bool(handle, "Device.WiFi.SSID.5.Enable", false);
+    ok &= set_bool(handle, "Device.WiFi.SSID.6.Enable", false);
+    ok &= set_bool(handle, "Device.WiFi.ApplyAccessPointSettings", true);
+    return ok;
+}
+
+/*
+ * Retry until every onboarding VAP is disabled. Caller may already hold
+ * onboarding_mutex; RBus work is independent of that lock's waiters.
+ */
+static bool close_onboarding_vaps_until_done(rbusHandle_t handle)
+{
+    rbusHandle_t local = NULL;
+    rbusHandle_t active = handle;
+    bool ok;
+
+    do {
+        if (active == NULL) {
+            if (rbus_open(&local, "wps_onboarding_teardown") !=
+                    RBUS_ERROR_SUCCESS) {
+                log_message(LOG_ERR,
+                    "Unable to open RBus for onboarding teardown; retrying");
+                sleep(1);
+                continue;
+            }
+            active = local;
+        }
+
+        ok = close_onboarding_vaps(active);
+        if (local != NULL) {
+            rbus_close(local);
+            local = NULL;
+            active = handle;
+        }
+        if (!ok) {
+            log_message(LOG_ERR, "Onboarding teardown incomplete; retrying");
+            sleep(1);
+        }
+    } while (!ok);
+
+    return true;
+}
+
+static bool open_onboarding_vaps(rbusHandle_t handle)
+{
+    bool ok = true;
+
+    ok &= set_bool(handle, "Device.WiFi.AccessPoint.5.WPS.Enable", true);
+    ok &= set_bool(handle, "Device.WiFi.SSID.5.Enable", true);
+    ok &= set_bool(handle, "Device.WiFi.AccessPoint.5.Enable", true);
+    ok &= set_bool(handle,
+        "Device.WiFi.AccessPoint.5.WPS.X_CISCO_COM_ActivatePushButton", true);
+    ok &= set_bool(handle, "Device.WiFi.AccessPoint.6.WPS.Enable", true);
+    ok &= set_bool(handle, "Device.WiFi.SSID.6.Enable", true);
+    ok &= set_bool(handle, "Device.WiFi.AccessPoint.6.Enable", true);
+    ok &= set_bool(handle,
+        "Device.WiFi.AccessPoint.6.WPS.X_CISCO_COM_ActivatePushButton", true);
+    ok &= set_bool(handle, "Device.WiFi.ApplyAccessPointSettings", true);
+    return ok;
+}
+
+static void *onboarding_timer(void *unused)
+{
+    (void)unused;
+
+    pthread_mutex_lock(&onboarding_mutex);
+    for (;;) {
+        int rc;
+
+        while (!onboarding_armed) {
+            pthread_cond_wait(&onboarding_cond, &onboarding_mutex);
+        }
+
+        rc = pthread_cond_timedwait(&onboarding_cond, &onboarding_mutex,
+            &onboarding_deadline);
+        if (rc == 0) {
+            /* A repeated press supplied a new deadline. */
+            continue;
+        }
+        if (rc != ETIMEDOUT) {
+            log_message(LOG_ERR, "Onboarding timer wait failed: %d", rc);
+            continue;
+        }
+
+        /*
+         * Hold the lock for the whole teardown. Button handling opens and
+         * arms under the same lock, so an expired timer cannot disable a
+         * window that was started after this deadline fired.
+         */
+        onboarding_armed = false;
+        log_message(LOG_INFO, "WPS onboarding window expired");
+        /* Drop the lock for teardown so a new press can open+arm without
+         * deadlocking against close_onboarding_vaps_until_done retries. */
+        pthread_mutex_unlock(&onboarding_mutex);
+        (void)close_onboarding_vaps_until_done(NULL);
+        pthread_mutex_lock(&onboarding_mutex);
+    }
+    /* NOTREACHED */
+    pthread_mutex_unlock(&onboarding_mutex);
+    return NULL;
+}
+
+static void init_onboarding_timer(void)
+{
+    pthread_condattr_t attr;
+    pthread_t thread;
+
+    pthread_condattr_init(&attr);
+    pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
+    pthread_cond_init(&onboarding_cond, &attr);
+    pthread_condattr_destroy(&attr);
+
+    if (pthread_create(&thread, NULL, onboarding_timer, NULL) == 0) {
+        pthread_detach(thread);
+        onboarding_timer_ready = true;
     } else {
-        printf("Successfully set %s.\n", param);
+        log_message(LOG_ERR, "Unable to create WPS onboarding timer");
     }
+}
 
-    pthread_mutex_unlock(&wps_mutex);
+/*
+ * Open the dedicated VAPs and arm the window under one critical section so
+ * timer expiry cannot interleave with a new press.
+ */
+static bool open_and_arm_onboarding_window(rbusHandle_t handle)
+{
+    bool ok;
+
+    pthread_once(&onboarding_once, init_onboarding_timer);
+
+    pthread_mutex_lock(&onboarding_mutex);
+    while (!startup_cleanup_done) {
+        log_message(LOG_INFO,
+            "Waiting for startup onboarding cleanup before opening a window");
+        pthread_cond_wait(&onboarding_cond, &onboarding_mutex);
+    }
+
+    if (!onboarding_timer_ready) {
+        log_message(LOG_ERR,
+            "Onboarding timer unavailable; refusing to open a window");
+        pthread_mutex_unlock(&onboarding_mutex);
+        (void)close_onboarding_vaps_until_done(handle);
+        return false;
+    }
+
+    ok = open_onboarding_vaps(handle);
+    if (!ok) {
+        log_message(LOG_ERR,
+            "Failed to open onboarding VAPs; tearing down until disabled");
+        pthread_mutex_unlock(&onboarding_mutex);
+        (void)close_onboarding_vaps_until_done(handle);
+        return false;
+    }
+
+    clock_gettime(CLOCK_MONOTONIC, &onboarding_deadline);
+    onboarding_deadline.tv_sec += ONBOARDING_WINDOW_SECONDS;
+    onboarding_armed = true;
+    pthread_cond_signal(&onboarding_cond);
+    pthread_mutex_unlock(&onboarding_mutex);
+    log_message(LOG_INFO, "Onboarding VAPs opened; window armed for %d seconds",
+        ONBOARDING_WINDOW_SECONDS);
+    return true;
+}
+
+static void *onboarding_startup_cleanup(void *unused)
+{
+    (void)unused;
+
+    (void)close_onboarding_vaps_until_done(NULL);
+
+    pthread_once(&onboarding_once, init_onboarding_timer);
+    pthread_mutex_lock(&onboarding_mutex);
+    startup_cleanup_done = true;
+    pthread_cond_broadcast(&onboarding_cond);
+    pthread_mutex_unlock(&onboarding_mutex);
+    log_message(LOG_INFO, "Startup onboarding cleanup complete");
+    return NULL;
 }
+#endif
+
+void start_onboarding_cleanup(void)
+{
+#ifndef CONFIG_EXTENDER
+    pthread_t thread;
 
-// The active callback function
+    if (pthread_create(&thread, NULL, onboarding_startup_cleanup, NULL) == 0) {
+        pthread_detach(thread);
+    } else {
+        log_message(LOG_ERR, "Unable to start onboarding cleanup thread");
+    }
+#endif
+}
+
+void cleanup_onboarding_vaps(void)
+{
+#ifndef CONFIG_EXTENDER
+    pthread_mutex_lock(&onboarding_mutex);
+    onboarding_armed = false;
+    (void)close_onboarding_vaps_until_done(NULL);
+    pthread_mutex_unlock(&onboarding_mutex);
+#endif
+}
+
+/* The active callback function */
 static button_callback event_callback = default_button_callback;
 
 void default_button_callback(const char *device, int button_code, int value) {
@@ -58,43 +294,55 @@
     log_message(LOG_INFO, "Device: %s, Button %d %s", 
            device, button_code, action);
 
-    rbusHandle_t handle;
+    rbusHandle_t handle = NULL;
     rbusError_t err;
     char button_name[32];
+
+    /*
+     * Ignore release and autorepeat events. The keycode is board specific:
+     * Filogic gpio-keys labels the button "WPS" but assigns KEY_RESTART, so
+     * the code itself is not used to identify the button.
+     */
+    if (value != 1) {
+        return;
+    }
+
     snprintf(button_name, sizeof(button_name), "wps_button_%d", button_code);
 
-    // Initialize RBus
-    //err = rbus_open(&handle, "wps_push_button");
     err = rbus_open(&handle, button_name);
     if (err != RBUS_ERROR_SUCCESS) {
-        printf("Failed to initialize RBus: %d\n", err);
+        log_message(LOG_ERR, "Failed to initialize RBus: %d", err);
+        return;
     }
 
-    // Set WPS Push Button for Access Point 1
-    log_message(LOG_INFO, "WPS button pressed on device %s - triggering WPS action for 2G", device);
-    set_wps_push_button(handle, "Device.WiFi.AccessPoint.1.WPS.X_CISCO_COM_ActivatePushButton");
-
-    // Set WPS Push Button for Access Point 2
-    log_message(LOG_INFO, "WPS button pressed on device %s - triggering WPS action for 5G", device);
-    set_wps_push_button(handle, "Device.WiFi.AccessPoint.2.WPS.X_CISCO_COM_ActivatePushButton");
-    sleep(WPS_DELAY);
+#ifdef CONFIG_EXTENDER
+    log_message(LOG_INFO,
+        "WPS button pressed on %s - triggering extender station WPS", device);
+    set_wps_push_button(handle,
+        "Device.WiFi.AccessPoint.16.WPS.X_CISCO_COM_ActivatePushButton");
+#else
+    log_message(LOG_INFO,
+        "WPS button pressed on %s - opening dedicated onboarding VAPs", device);
+    if (!open_and_arm_onboarding_window(handle)) {
+        log_message(LOG_ERR, "Unable to open a usable onboarding window");
+    }
+#endif
 
-    // Close RBus
     rbus_close(handle);
 }
 
 void custom_wps_button_callback(const char *device, int button_code, int value) {
-    // Check if the button code matches what we're looking for
-    // Button codes: KEY_WPS_BUTTON (0x211) or BTN_0 (0x100)
+    /* Check if the button code matches what we're looking for */
+    /* Button codes: KEY_WPS_BUTTON (0x211) or BTN_0 (0x100) */
     if (button_code == 0x211 || button_code == 0x100) {
-        if (value == 1) { // Button pressed
+        if (value == 1) { /* Button pressed */
             log_message(LOG_INFO, "WPS button pressed on device %s - triggering WPS action", device);
             
-            // Here you would add code to trigger the actual WPS functionality
+            /* Here you would add code to trigger the actual WPS functionality */
             system("echo 'WPS button pressed' >> /tmp/wps_events.log");
         }
     } else {
-        // For other buttons, use the default behavior
+        /* For other buttons, use the default behavior */
         default_button_callback(device, button_code, value);
     }
 }
